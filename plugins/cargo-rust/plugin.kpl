// cargo-rust — build, test, lint, format, and clean a Cargo project.
//
// The worked example from design doc §5.10, extended with the `check` and
// `run` commands from the §8 CLI surface.

manifest {
  name        = "cargo-rust"
  version     = "1.0.0"
  api_version = 1
  priority    = 40
  composable  = false
  supersedes  = []
}

detect {
  file_exists "Cargo.toml"
}

requires {
  any_of   [cargo]
  optional [rustfmt, clippy]
}

schema {
  release: bool = false
  check:   bool = false

  // Passed as `--features a,b`. Empty means "cargo's defaults".
  features: str = ""

  // `--all-features` overrides `features` when set, matching cargo's own rule.
  all_features: bool = false

  // What `kap run` runs, for a workspace with several binaries. Empty lets
  // cargo pick, which works for a single-binary crate.
  bin: str = ""
}

command build(project, config, extra) {
  // `release` is a plain bool rather than an enum because there are exactly
  // two states and `--release` is the only flag either one produces.
  let flags = if config.release then ["--release"] else []
  if config.all_features {
    flags = flags + ["--all-features"]
  } else if config.features != "" {
    flags = flags + ["--features", config.features]
  }
  step ["cargo", "build"] + flags + extra
}

command test(project, config, extra) {
  step ["cargo", "test"] + extra
}

command check(project, config, extra) {
  step ["cargo", "check"] + extra
}

command run(project, config, extra) {
  let flags = if config.release then ["--release"] else []
  if config.bin != "" { flags = flags + ["--bin", config.bin] }
  step ["cargo", "run"] + flags + extra
}

command install(project, config, extra) {
  // `--path .` installs *this* crate rather than fetching one from crates.io,
  // which is what `kap install` means in a project directory.
  step ["cargo", "install", "--path", "."] + extra
}

command dev(project, config, extra) {
  // cargo-watch is not part of cargo, so this is a plain step that fails
  // loudly if it is not installed — the executor reports "cannot run
  // cargo-watch", which is a better answer than kap silently doing nothing.
  step ["cargo", "watch", "-x", "run"] + extra
}

// `kap ci` — declared explicitly rather than left to kap's fmt+lint+test
// fallback, because the order and the `--check` matter and a Rust CI job is a
// well-known three-step recipe.
command ci(project, config) {
  step ["cargo", "fmt", "--", "--check"]
  step ["cargo", "clippy", "--all-targets", "--", "-D", "warnings"]
  step ["cargo", "test"]
}

command lint(project, config) {
  step ["cargo", "clippy", "--", "-D", "warnings"]
}

command fmt(project, config) {
  // `kap fmt --set check=true` verifies formatting instead of rewriting it,
  // which is what a CI job wants.
  let args = if config.check then ["--", "--check"] else []
  step ["cargo", "fmt"] + args
}

command clean(project, config) {
  step ["cargo", "clean"]
  report_freed_space
}
