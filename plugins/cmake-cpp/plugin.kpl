// cmake-cpp — build, test, and clean a CMake project.
//
// This is the worked example from design doc §5.3. Everything kap knows about
// CMake lives in this file: the binary itself has no idea what a CMakeLists.txt
// is. Read docs/design.md §5 for the language, or howto.md for a guided tour.

manifest {
  name        = "cmake-cpp"
  version     = "1.0.0"
  api_version = 1
  priority    = 30
  composable  = false
  supersedes  = []
}

// Which projects this plugin claims. Evaluated by the detection engine
// (Milestone 4), never by the interpreter.
detect {
  file_exists "CMakeLists.txt"
}

// Tools the commands below shell out to. `kap doctor` reports on these.
requires {
  any_of   [cmake]
  optional [ninja, make, ccache]
}

// Everything a user may override in ~/.config/kap/config.toml or ./kap.toml.
// The core validates overrides against these declarations before any KPL runs,
// so a typo fails with a clear message rather than a confusing command line.
schema {
  generator:  enum { auto, ninja, make, unix_makefiles } = auto
  build_dir:  str       = "build"
  build_type: str       = "Debug"
  cmake_args: list<str> = []

  // `kap run` needs to know which target to execute; CMake has no notion of
  // "the" binary. Empty means `kap run` says so instead of guessing.
  run_target: str = ""

  // What `kap install` passes as the prefix. Empty leaves CMake's default.
  install_prefix: str = ""

  // clang-format is not part of CMake, so formatting is opt-in: set the glob
  // your sources match. Empty means `kap fmt` reports that it has nothing
  // configured rather than reformatting a tree at random.
  format_glob: str = ""

  // `kap fmt --set check=true` verifies instead of rewriting, for CI.
  check: bool = false
}

command build(project, config, extra) {
  let dir = config.build_dir

  step mkdir "-p" dir

  let configure = ["cmake", "-S", ".", "-B", dir]

  // `auto` prefers Ninja when it is installed and otherwise says nothing at
  // all, letting CMake pick its own platform default. `none` is how a KPL
  // expression says "no value"; the flag below is simply not added.
  let generator = match config.generator {
    auto           => if project.tool("ninja") then "Ninja" else none,
    ninja          => "Ninja",
    make           => "Unix Makefiles",
    unix_makefiles => "Unix Makefiles",
  }

  if generator != none {
    configure = configure + ["-G", generator]
  }

  configure = configure + ["-DCMAKE_BUILD_TYPE=" + config.build_type]
  configure = configure + config.cmake_args
  step configure

  // Passthrough arguments (everything after `--` on the command line) go to
  // the build, not to the configure step: `kap build -- --target foo`.
  step ["cmake", "--build", dir] + extra
}

command test(project, config, extra) {
  step ["ctest", "--test-dir", config.build_dir, "--output-on-failure"] + extra
}

// `kap check` — configure only. It is the cheapest thing that catches a broken
// CMakeLists.txt, an unfindable dependency, or a missing toolchain, which is
// exactly what a typecheck-only pass is for in a language that has no such
// thing at the build-system level.
command check(project, config, extra) {
  let dir = config.build_dir
  step mkdir "-p" dir

  let configure = ["cmake", "-S", ".", "-B", dir]
  let generator = match config.generator {
    auto           => if project.tool("ninja") then "Ninja" else none,
    ninja          => "Ninja",
    make           => "Unix Makefiles",
    unix_makefiles => "Unix Makefiles",
  }
  if generator != none {
    configure = configure + ["-G", generator]
  }
  configure = configure + ["-DCMAKE_BUILD_TYPE=" + config.build_type]
  configure = configure + config.cmake_args
  step configure + extra
}

command run(project, config, extra) {
  // CMake cannot tell kap which binary you meant, so this is configuration
  // rather than a guess:
  //     kap run --set run_target=demo
  //     # or, permanently, in kap.toml:
  //     #   [plugins.cmake-cpp]
  //     #   run_target = "demo"
  step [config.build_dir + "/" + config.run_target] + extra
}

command install(project, config, extra) {
  let cmd = ["cmake", "--install", config.build_dir]
  if config.install_prefix != "" { cmd = cmd + ["--prefix", config.install_prefix] }
  step cmd + extra
}

command fmt(project, config, extra) {
  // Opt-in, because there is no way to know which files are yours: a CMake
  // project's tree routinely contains vendored sources and generated output,
  // and reformatting those would be worse than doing nothing.
  let flags = if config.check then ["--dry-run", "--Werror"] else ["-i"]
  for file in project.glob(config.format_glob) {
    step ["clang-format"] + flags + [file] + extra
  }
}

command lint(project, config, extra) {
  // clang-tidy reads the compilation database CMake writes when
  // CMAKE_EXPORT_COMPILE_COMMANDS is on, which is why this points at the build
  // directory rather than at source files.
  step ["clang-tidy", "-p", config.build_dir] + project.glob(config.format_glob) + extra
}

command clean(project, config) {
  step rm "-rf" config.build_dir
  report_freed_space
}
